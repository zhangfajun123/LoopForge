# LoopForge 部署变量模板。复制为 .env 后按需修改；.env 不入库。
# 原则：镜像与绑定方式都写在这里（或写进镜像），不要在 compose.override.yaml 里手工打补丁 ——
# 否则每次重新部署都会被覆盖回去。

# ---- 数据库 ----
LOOPFORGE_DB_PASSWORD=CHANGE_ME
LOOPFORGE_DB_ROOT_PASSWORD=CHANGE_ME
LOOPFORGE_MYSQL_PORT=33315
COMPOSE_PROJECT_NAME=loopforge
AGENTFLOW_MYSQL_DSN='loopforge:CHANGE_ME@tcp(127.0.0.1:33315)/loopforge'

# ---- 平台 ----
AGENTFLOW_HTTP_PORT=8090
# 绑定地址：0.0.0.0=内网直连（默认）；127.0.0.1=只在有反代/Caddy 时使用
LOOPFORGE_BIND=0.0.0.0
# 对外地址（反代域名或公网地址），用于回调/分享链接；留空则用请求头推断
LOOPFORGE_PUBLIC_URL=
# 平台镜像：**必须**指到自带 CLI 的能力镜像，否则每次部署都要在宿主机补 CLI
# 例：swr.cn-north-4.myhuaweicloud.com/swr-hd-mig/loopforge:clis
LOOPFORGE_IMAGE=swr.cn-north-4.myhuaweicloud.com/swr-hd-mig/loopforge:clis
LOOPFORGE_DATA_DIR=./.data

# ---- 认证与安全 ----
AGENTFLOW_AUTH_REQUIRED=1
AGENTFLOW_ALLOW_SIGNUP=false
AGENTFLOW_SESSION_SECRET=CHANGE_ME
# 沙箱/隔离执行需要容器编排能力；按 P0 要求优先用受限代理，避免直接挂 docker.sock
LOOPFORGE_DOCKER_SOCKET=/var/run/docker.sock

# ---- Agent CLI ----
# 能力镜像内已装并设好下列变量；仅当改用自定义路径时才需要在这里覆盖
# AGENTFLOW_OPENCODE_BIN=/usr/local/bin/opencode
# AGENTFLOW_CODEX_BIN=/usr/local/bin/codex
# AGENTFLOW_DSH_BIN=/usr/local/bin/dsh
# AGENTFLOW_HERMES_BIN=/opt/hermes-home/.hermes/bin/hermes
# AGENTFLOW_HERMES_HOME=/opt/hermes-home