# syntax=docker/dockerfile:1
# 能力镜像：在平台镜像之上预装 Agent CLI（opencode / codex / dsh，可选 Hermes），
# 这样每次部署都自带执行器，不需要在宿主机装 CLI、也不依赖 compose.override 里的 AGENTFLOW_*_BIN。
#
# 用法：
#   docker build -f deploy/Dockerfile.agent-clis \
#     --build-arg BASE=<平台镜像> \
#     --build-arg WITH_HERMES=1 \
#     -t loopforge:clis .
ARG BASE=swr.cn-north-4.myhuaweicloud.com/swr-hd-mig/loopforge:190d948-202611161657UTC
FROM ${BASE}

ARG NPM_REGISTRY=https://registry.npmmirror.com
# 下次升级 Node：dsh 的 engines 要求 >=24.9.0（当前基础镜像自带 22.23.5，只告警不阻塞）。
# 升级方式：把 NODE_MAJOR 提到 24，装官方 tarball 到 /usr/local 覆盖旧版本，
# 再执行 npm 安装；同时用 engine-strict 把引擎不匹配从 warning 变成硬失败。
ARG NODE_MAJOR=22
ARG OPENCODE_VERSION=1.19.5
ARG CODEX_VERSION=0.169.0
ARG DSH_VERSION=0.2.2-rc.1
ARG WITH_HERMES=0

USER root
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# 三个 CLI 一起装：失败立即中止构建（缺任何一个都不该产出镜像）。
# npm 缓存挂在 BuildKit cache mount 上，重复构建不必重新下载（首次 ~5-6 分钟，命中后 ~30-60 秒）。
RUN --mount=type=cache,target=/root/.npm set -eux; \
    if command -v opencode >/dev/null && command -v codex >/dev/null && command -v dsh >/dev/null; then \
        echo "基础镜像已自带三个 CLI，跳过安装（避免重复占 ~2.8GB 层）"; \
    else \
        npm install -g --no-audit --no-fund \
            "opencode-ai@${OPENCODE_VERSION}" \
            "@openai/codex@${CODEX_VERSION}" \
            "@deepseek-ai/dsh@${DSH_VERSION}"; \
    fi; \
    for b in opencode codex dsh; do \
        command -v "$b" >/dev/null || { echo "FATAL: $b 未装上"; exit 1; }; \
        echo "$b -> $(command -v "$b") $("$b" --version 2>&1 | head -1)"; \
    done
# 注意：不要在这里 `npm cache clean`（缓存在 mount 里、不进镜像层，清掉只会让下次重建重下载）。
# 实测 npm 缓存 mount 对 `npm install -g` 提速有限（359s → 384s），真正的省法是让基础镜像
# 自带 CLI 或把 CLI 层单独固定成一个很少变动的 base，平台镜像只在上面重编 Go。

# 显式指向镜像内路径：即使 PATH 被改写，平台也能解析到
ENV AGENTFLOW_OPENCODE_BIN=/usr/local/bin/opencode \
    AGENTFLOW_CODEX_BIN=/usr/local/bin/codex \
    AGENTFLOW_DSH_BIN=/usr/local/bin/dsh

# Hermes 原生执行器：安装脚本把依赖环境提交在安装 home 内，所以固定 /opt/hermes-home，
# 绝不使用宿主机 /root（P0 约束）。安装器把命令放到 ~/.local/bin，用符号链接固化成 /usr/local/bin/hermes。
RUN if [ "${WITH_HERMES}" = "1" ]; then \
        set -eux; \
        apt-get update; \
        apt-get install -y --no-install-recommends libxi6 libxtst6 libx11-6 libxext6; \
        rm -rf /var/lib/apt/lists/*; \
        mkdir -p /opt/hermes-home; \
        HOME=/opt/hermes-home sh -c 'curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash'; \
        HB="$(HOME=/opt/hermes-home bash -lc 'command -v hermes' || true)"; \
        test -n "${HB}" || { echo "FATAL: hermes 命令未找到"; exit 1; }; \
        echo "hermes 安装位置: ${HB}"; \
        ln -sf "${HB}" /usr/local/bin/hermes; \
        HOME=/opt/hermes-home /usr/local/bin/hermes --version; \
    else \
        echo "skip hermes (WITH_HERMES=0)"; \
    fi

ENV AGENTFLOW_HERMES_HOME=/opt/hermes-home/.hermes \
    AGENTFLOW_HERMES_BIN=/usr/local/bin/hermes \
    HERMES_HOME=/opt/hermes-home/.hermes

# 让 `docker run` 直接能看到版本，部署后可一条命令自检
LABEL org.opencontainers.image.title="loopforge + agent CLIs" \
      org.opencontainers.image.description="LoopForge platform with opencode/codex/dsh preinstalled"